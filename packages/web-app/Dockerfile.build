# Self-contained web image (TG0-INF-7, used by CI). Builds the bundle from
# source, then serves via nginx. Local dev can use the slim Dockerfile instead.
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN cd packages/web-app && pnpm install --frozen-lockfile --filter @eim/web-app... && pnpm --filter @eim/web-app build

FROM nginx:1.27-alpine
COPY --from=build /repo/packages/web-app/dist/ /usr/share/nginx/html/
EXPOSE 8080
RUN sed -i 's/listen       80;/listen       8080;/' /etc/nginx/conf.d/default.conf
