{
  "name": "eim-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "node scripts/gen-api-client.mjs && node scripts/gen-zod-schemas.mjs",
    "codegen:freshness": "node scripts/check-codegen-freshness.mjs",
    "audit:mappings": "node scripts/check-audit-mappings.mjs",
    "golden": "node scripts/golden-test.mjs",
    "openapi:lint": "spectral lint openapi/*.yaml",
    "web-budget": "node scripts/check-web-budget.mjs",
    "verify:tg0": "bash scripts/verify-tg0.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stoplight/spectral-cli": "^6.14.1",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.5.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
